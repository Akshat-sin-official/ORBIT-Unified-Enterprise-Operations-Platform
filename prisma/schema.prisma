// ─── Enterprise Notification Settings & In-App Alerts ────────────────────────

model NotificationSetting {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  category        String   @map("category") // TICKET_CREATED, TECHNICIAN_ASSIGNED, WORK_ORDER_COMPLETED, INVOICE_GENERATED, WARRANTY_CLAIM_UPDATED, LOW_STOCK_ALERT
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
