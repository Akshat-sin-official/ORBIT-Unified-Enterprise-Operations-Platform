# Database
DATABASE_URL=postgresql://orbit:orbit_secret@localhost:5433/orbit_db?schema=public
POSTGRES_PORT=5433
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit_secret
POSTGRES_DB=orbit_db

# Redis
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# MinIO (S3-compatible Object Storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=orbit_minio
MINIO_SECRET_KEY=orbit_minio_secret

# App
PORT=5000
NODE_ENV=development
