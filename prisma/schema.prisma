  apiKey         String   @default("429683C4C977415CAAFCCE10F7D57E11") @map("api_key")
  instanceId     String?  @map("instance_id")
  instanceName   String   @default("orbit-ops") @map("instance_name")
  instanceToken  String   @default("token_primary_123456") @map("instance_token")
  jid            String?  @map("jid")
  phoneNumber    String?  @map("phone_number")
  isConnected    Boolean  @default(false) @map("is_connected")
